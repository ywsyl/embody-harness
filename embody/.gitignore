.DS_Store
node_modules/
dist/
lib/
*.tsbuildinfo
__pycache__/
*.pyc
.venv/
.dsh-dev/

# 无需入库的代码目录
runtime_files/
reference/
test/

# scripts/manual/

# 本机凭据一律不入库。
#   secret.env        模型服务参数与密钥（端点 / API key / 模型名）：这批值的唯一一处，
#                     读者是 scripts/settings-seed.sh 与 scripts/role-daemon.sh（经 lib-local-env.sh）
#   *.secret          由它派生的凭据留存
#   .credentials.yaml credentials-local 的落点（$DSH_HOME/.credentials.yaml 的副本）
#   .env.local        本机环境文件的另一种写法（名字恰为 `.env` 的由仓库根 .gitignore 管）
secret.env
*.secret
.credentials.yaml
.env.local
