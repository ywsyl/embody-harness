{
  // file-guard 作为引擎图外的叶子项目（与 ../location-context、../rolebus 同形）。引擎依赖
  // （@deepseek-ai/cordis、schemastery、dsh-tools）经 tsconfig.base.json 的 `paths` 解析到各
  // 包 src；本文件用 `references` 声明这些 src 归属的编译项目，`tsc -b` 会先按各包自身 tsconfig
  // 构建出 d.ts，再对本包校验——这正是引擎“per-package 编译边界”的形态。产物 lib/ 与引擎各包
  // lib/types 都已被 .gitignore 忽略，构建只写产物、不动引擎源码。
  // 引用列表 = 本包真正 import 的那些包：cordis（Context）、schemastery（Config 校验）、
  // tools（tools/pre-execute 事件与 PreToolDecision）。agent / session 是 d.ts 跟着 ToolExecution
  // 的 `agent` 字段一起走到的那两层（`exec.agent.session.header.cwd`），dsh-tools 的声明引用了它们，
  // 故同样列进来。与 ../task-context 只差 tools 那条。
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../../../vendor/schemastery"
    },
    {
      "path": "../../../packages/core/tools"
    },
    {
      "path": "../../../packages/core/agent"
    },
    {
      "path": "../../../packages/core/session"
    }
  ]
}
