{
  // rolebus 作为引擎图外的叶子项目。引擎依赖（@deepseek-ai/cordis、schemastery、
  // dsh-tools、dsh-home-paths）经 tsconfig.base.json 的 `paths` 解析到各包 src；
  // 本文件用 `references` 声明这些 src 归属的编译项目，`tsc -b` 会先按各包自身
  // tsconfig（vendor/cordis 等各自关闭 strict 子旗标）构建出 d.ts，再对本包校验——
  // 这正是引擎“per-package 编译边界”的形态，避免把 vendor 源码按本包旗标重编译。
  // `tsc -b` 的叶子也必须 composite；产物 lib/（本包 Loader boot 前用）与引擎各包
  // lib/types 都已被 .gitignore 忽略，构建只写产物、不动引擎源码。
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../../../vendor/schemastery"
    },
    {
      "path": "../../../packages/core/agent"
    },
    {
      "path": "../../../packages/core/agent-default-model"
    },
    {
      "path": "../../../packages/core/session"
    },
    {
      "path": "../../../packages/core/tools"
    },
    {
      "path": "../../../packages/llm/llm"
    },
    {
      "path": "../../../packages/session/session-persistence"
    },
    {
      "path": "../../../packages/util/brand"
    },
    {
      "path": "../../../packages/util/home-paths"
    }
  ]
}
