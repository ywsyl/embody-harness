{
  "name": "@embody/dsh-rolebus",
  "version": "0.4.0",
  "private": true,
  "description": "embody-harness 角色间文件传输事件总线：跨独立 dsh profile/进程收发 src/event-catalog.ts 声明的结构化事件，并按角色注册具名发件工具（里程碑 1：真总线）。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
