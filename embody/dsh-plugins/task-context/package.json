{
  "name": "@embody/dsh-task-context",
  "version": "0.1.0",
  "private": true,
  "description": "embody 编排器的待做任务清单注入：每个轮次把 runtime_files/tasks/pending_tasks.yaml 的全文作为一条 user 消息插在事件之前（清单不再经 task_list 工具按需读；谁该做哪条由条目上的 owner 字段交给模型判断）。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
