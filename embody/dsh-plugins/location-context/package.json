{
  "name": "@embody/dsh-location-context",
  "version": "0.1.0",
  "private": true,
  "description": "embody 交互器与监督器的【支持地点清单】注入：每个轮次把 configs/configs.py 的 supported_locations_text()（load_supported_locations 的渲染）作为一条 user 消息插在唤醒消息之前。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
