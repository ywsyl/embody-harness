[Unit]
Description=Navigation HTTP Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/cmcc_agent/skills/waypoint_nav/codes
ExecStart=/bin/bash /root/cmcc_agent/skills/waypoint_nav/codes/start_app.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
